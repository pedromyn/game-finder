<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_cover_placeholder"
                android:contentDescription="@string/cover_description"
                android:scaleType="centerCrop" />

            <LinearLayout style="@style/Screen">

                <TextView
                    android:id="@+id/tvName"
                    style="@style/Text.Title" />

                <TextView
                    android:id="@+id/tvScore"
                    style="@style/Text.Score"
                    android:layout_marginTop="4dp"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/Text"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    style="@style/Text.Section"
                    android:text="@string/detail_genres" />

                <TextView
                    android:id="@+id/tvGenres"
                    style="@style/Text.Secondary"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Text.Section"
                    android:text="@string/detail_platforms" />

                <TextView
                    android:id="@+id/tvPlatforms"
                    style="@style/Text.Secondary"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Text.Section"
                    android:text="@string/detail_mode" />

                <TextView
                    android:id="@+id/tvMode"
                    style="@style/Text.Secondary"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Text.Section"
                    android:text="@string/detail_length" />

                <TextView
                    android:id="@+id/tvLength"
                    style="@style/Text.Secondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnStore"
                    style="@style/Button.Primary"
                    android:layout_marginTop="28dp"
                    android:text="@string/action_open_store" />

                <Button
                    android:id="@+id/btnShare"
                    style="@style/Button.Secondary"
                    android:layout_marginTop="8dp"
                    android:text="@string/action_share" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/state"
        layout="@layout/view_state" />

</FrameLayout>
